# MLflow tracking endpoint used when running the pipeline OUTSIDE Kubernetes
# (e.g. `dvc repro` on your workstation or via docker-compose). In-cluster runs
# get this from the Kustomize ConfigMap instead (k8s/base/configmap.yaml), which
# points at the persistent in-cluster MLflow Tracking Server.
#
# DagsHub has been removed (ADR-026): experiment tracking now runs on the project's
# own MLflow platform (PostgreSQL + S3), so no tracking username/password is needed
# — the server is internal and unauthenticated. For local, non-cluster runs, point
# this at a reachable MLflow server. Options:
#   * a `kubectl -n mlops port-forward svc/mlflow 5000:5000` to the in-cluster
#     server:            http://127.0.0.1:5000
#   * a local `mlflow server` you run yourself
#   * a local file store: file:./mlruns   (set MLFLOW_ALLOW_FILE_STORE=true)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Opt-in for a local file-store tracking URI. A file:/scheme-less URI records runs
# to the local filesystem; in a cluster that is the pod's ephemeral storage, so
# all tracking is lost when the pod exits. src/mlflow_config.py therefore REJECTS a
# file store unless this flag is truthy (1/true/yes/on). Leave it unset for normal
# use against a real server; set it only for deliberate offline development.
# MLFLOW_ALLOW_FILE_STORE=true

# Experiment the pipeline's runs are grouped under (optional; defaults to
# "mlops-pipeline"). Set to separate, e.g., local experiments from CI or cloud.
# MLFLOW_EXPERIMENT_NAME=mlops-pipeline
