# MLflow tracking endpoint used when running the pipeline OUTSIDE Kubernetes
# (e.g. `dvc repro` on your workstation or via docker-compose). In-cluster runs
# get this from the Kustomize ConfigMap instead (k8s/base/configmap.yaml), which
# points at the persistent in-cluster MLflow Tracking Server.
#
# DagsHub has been removed (ADR-026): experiment tracking now runs on the project's
# own MLflow platform (PostgreSQL + S3), so no tracking username/password is needed
# — the server is internal and unauthenticated. For local, non-cluster runs, point
# this at a reachable MLflow server. Options:
#   * a `kubectl -n mlops port-forward svc/mlflow 5000:5000` to the in-cluster
#     server:            http://127.0.0.1:5000
#   * a local `mlflow server` you run yourself
#   * a local file store: file:./mlruns   (set MLFLOW_ALLOW_FILE_STORE=true)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Opt-in for a local file-store tracking URI. A file:/scheme-less URI records runs
# to the local filesystem; in a cluster that is the pod's ephemeral storage, so
# all tracking is lost when the pod exits. src/mlflow_config.py therefore REJECTS a
# file store unless this flag is truthy (1/true/yes/on). Leave it unset for normal
# use against a real server; set it only for deliberate offline development.
# MLFLOW_ALLOW_FILE_STORE=true

# Experiment the pipeline's runs are grouped under (optional; defaults to
# "mlops-pipeline"). Set to separate, e.g., local experiments from CI or cloud.
# MLFLOW_EXPERIMENT_NAME=mlops-pipeline

# ---------------------------------------------------------------------------
# Runtime dataset retrieval (Sprint 7, PR 8 — src/fetch_dataset.py, ADR-027).
# In Kubernetes these come from the ConfigMap + overlay (k8s/); set them here only
# if you want to exercise the S3 retrieval OUTSIDE the cluster. Normal workstation
# runs use the DVC data remote (`dvc pull`) and do not need these.
# ---------------------------------------------------------------------------
# The dataset object to fetch. On AWS: s3://<bucket>/pima-indians-diabetes/v1/data.csv
# (from `terraform output -raw dataset_s3_uri`). Against local MinIO:
# DATASET_S3_URI=s3://datasets/pima-indians-diabetes/v1/data.csv
#
# Where to write it (optional; defaults to data/raw/data.csv):
# DATASET_DEST=data/raw/data.csv
#
# Pinned SHA-256 of the dataset — the retrieval fails on a mismatch (see docs/dataset.md):
# DATASET_SHA256=ee5b0c92d5ad461e86151c544b3b76bd6269c6052c5eb628c4b0618a08cffc89
#
# S3-compatible endpoint for MinIO (leave UNSET for real Amazon S3; setting it also
# switches boto3 to path-style addressing):
# AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
#
# Credentials: on AWS these come from EKS Pod Identity (no keys needed). Against a
# local MinIO you provide its access key/secret via the standard AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY (throwaway MinIO creds — never real AWS keys) and AWS_DEFAULT_REGION.

# ---------------------------------------------------------------------------
# Operational metrics (Sprint 8, PR 3 — src/pipeline_metrics.py, ADR-030).
# ---------------------------------------------------------------------------
# Prometheus Pushgateway the pipeline pushes per-stage OPERATIONAL metrics to
# (duration + success/failure) so an ephemeral batch Job stays observable after its
# pod exits. In Kubernetes this is injected by the ConfigMap (k8s/base/configmap.yaml)
# pointing at the in-cluster Pushgateway Service. LEAVE IT UNSET for local `dvc repro`
# and docker-compose runs: emission is then a clean no-op (no gateway to reach, no
# metrics needed). Set it only to exercise the push path against a local gateway, e.g.
# a `kubectl -n monitoring port-forward svc/pushgateway 9091:9091`:
# PUSHGATEWAY_URL=http://127.0.0.1:9091
#
# This is OPERATIONAL metrics only — model accuracy and hyper-parameters stay in
# MLflow, never here (the ownership boundary, ADR-030).
