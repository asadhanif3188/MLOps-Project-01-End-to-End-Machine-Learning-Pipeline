myenv/
.env
models/
logs/
__pycache__/
*.pyc
*.pdf
# Root-level sprint planning docs only (anchored so it does not catch
# docs/reviews/sprint-*.md, which are tracked deliverables).
/Sprint-*.md

# Tooling caches (Ruff, mypy, pytest)
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Coverage data (pytest-cov writes .coverage plus per-process .coverage.* files)
.coverage
.coverage.*
htmlcov/
coverage.xml

# Terraform (Sprint 6, terraform/). Never commit provider caches, state, or
# real variable values — state can contain resolved account IDs and secrets.
# The committed terraform.tfvars.example (placeholders only) is intentionally
# NOT ignored.
.terraform/
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — the dependency lock
# file is committed so the provider version and checksums are reproducible.
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Terraform plan output artifacts (may contain sensitive values)
*.tfplan
tfplan
.terraformrc
terraform.rc
