# Example Terraform variable values for the MLOps AWS foundation.
#
# HOW TO USE
#   cp terraform.tfvars.example terraform.tfvars   # then edit as needed
#
# `terraform.tfvars` is gitignored (see the repository .gitignore). This example
# file is committed and MUST contain placeholders only.
#
# SECURITY — read before editing
#   Never put AWS access keys, secret keys, session tokens, account IDs, or any
#   other secret in this file or in terraform.tfvars. Credentials come from your
#   AWS CLI profile / environment, NOT from Terraform variables
#   (see terraform/README.md § Authentication & § Security). Everything below is
#   non-secret configuration.

# AWS region to operate in.
aws_region = "us-east-1"

# Naming/tagging prefix and environment.
project_name = "mlops-pipeline"
environment  = "dev"

# Owner recorded in the "Owner" tag (a name or team, NOT a credential).
owner = "your-name-or-team"

# Optional extra tags merged into the common tag set.
additional_tags = {
  # CostCenter = "ml-portfolio"
}

# --- Container registry / ECR (Sprint 7, PR 1) --------------------------------
# All non-secret. Left commented so the defaults apply (repository name follows
# project_name, retain 10 images). See terraform/variables.tf and
# terraform/README.md § Container registry.

# ecr_repository_name = "mlops-pipeline"   # defaults to project_name if unset
# ecr_max_image_count = 10                 # lifecycle policy: images to retain

# --- EKS platform (PR 4) ------------------------------------------------------
# All non-secret. Left commented so the cost-conscious defaults apply; uncomment
# to override. See terraform/variables.tf and terraform/README.md § EKS platform.

# Explicit Kubernetes version for the control plane + node group.
# kubernetes_version = "1.35"

# Node group sizing (fixed size; no autoscaler is installed).
# node_instance_types = ["t3.medium"]
# node_capacity_type  = "ON_DEMAND"   # or "SPOT" for cheaper, interruptible nodes
# node_desired_size   = 2
# node_min_size       = 2
# node_max_size       = 2
# node_disk_size      = 20

# API endpoint exposure. SECURE BY DEFAULT (finding H-02): the Kubernetes API
# server is PRIVATE-ONLY out of the box — public access is off and the public CIDR
# allow-list is empty, so nothing is exposed unless you opt in. Reaching a
# private-only endpoint needs in-VPC access (bastion / VPN / SSM / in-VPC runner).
#
# To run kubectl from your workstation for a validation run, opt into public
# access AND scope it to your own IP. An unrestricted 0.0.0.0/0 (any /0) is
# REJECTED by validation, and enabling public access with an empty CIDR list is
# rejected too (EKS would treat empty as 0.0.0.0/0). Uncomment BOTH lines together:
# cluster_endpoint_public_access       = true
# cluster_endpoint_public_access_cidrs = ["203.0.113.4/32"]   # YOUR IP/CIDR — never 0.0.0.0/0
#
# cluster_endpoint_private_access      = true   # on by default; the primary access path

# Control-plane logs shipped to CloudWatch (small cost). Set to [] to disable.
# cluster_enabled_log_types = ["api", "audit", "authenticator"]
